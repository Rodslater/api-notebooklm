# Token de segurança para autenticar as requisições na API (Bearer token do Administrador)
API_TOKEN=gerar_um_token_secreto_aqui

# Tokens adicionais para outros usuários ou sistemas (separados por vírgula, no formato nome:token ou apenas token)
# Cada usuário acessa e lista apenas as tarefas criadas pelo seu próprio token.
# Exemplo: API_TOKENS=cliente_a:token_secreto_a,cliente_b:token_secreto_b
API_TOKENS=

# Porta do servidor
PORT=8000
HOST=0.0.0.0

# Diretório onde ficam as credenciais do NotebookLM (master_token.json / storage_state.json)
NOTEBOOKLM_AUTH_DIR=./data/auth

# Diretório para armazenamento temporário dos áudios gerados
STORAGE_DIR=./storage

# Configurações padrão de geração de podcast
DEFAULT_LANGUAGE=pt
DEFAULT_AUDIO_FORMAT=brief
DEFAULT_AUDIO_LENGTH=default
DEFAULT_INSTRUCTIONS=Apresente em português brasileiro natural, descontraído e bem-humorado. Os apresentadores devem demonstrar carisma, usar tiradas inteligentes, analogias divertidas e manter a conversa leve e cativante, resumindo os pontos essenciais com clareza.

# Tempo máximo em segundos para esperar a geração do áudio pelo Google (padrão: 1200s / 20 minutos)
GENERATION_TIMEOUT_SECONDS=1200

# Se deve apagar o caderno no Google NotebookLM após o download do podcast
CLEANUP_NOTEBOOK=true
